menu "Matter C runtime laboratory"
config MATTER_C_RUNTIME_RGB
    bool "Experimental EP1 RGB light and DevKitM-1 GPIO8 WS2812"
    default n
    help
        Adds a volatile development light using standard OnOff, MoveToLevel,
        MoveToLevelWithOnOff, MoveToHueAndSaturation and Stop commands.
        This is an incomplete light profile for memory/IM/hardware testing,
        not a complete or certified Extended Color Light implementation.
config MATTER_C_RUNTIME_SOAK
    bool "Owner-thread soak telemetry and local UART fault controls"
    depends on MATTER_C_PROFILE_ALLOCATIONS
    default n
    help
        Samples internal heap every 100 ms and logs every five seconds.
        Local UART can inject one tracked allocation failure, reconnect the
        radio, drop RX briefly or defer one completion. No capacity changes.
config MATTER_C_RUNTIME_COMPARE_SAMPLER
    bool "SDK timer heap sampler for matched external-stack comparison"
    depends on MATTER_C_RUNTIME_SOAK
    default n
    help
        Adds the same 100 ms SDK timer observer as the ESP-Matter reference.
        Includes short blocking crypto phases missed by owner-loop sampling.
        Timer and observer costs are included. No protocol or limit changes.
config MATTER_C_RUNTIME_HEAP_AUDIT
    bool "Post-teardown heap maps and settled SDK memory samples"
    depends on MATTER_C_RUNTIME_SOAK
    default n
    help
        Laboratory-only allocation-free heap walks and samples through five
        seconds after teardown. Prints addresses/sizes, never block contents.
        UART logs belong in ignored private output. No protocol timer changes.
config MATTER_C_RUNTIME_HEAP_QUEUE_OWNERS
    bool "Record SDK queue/mutex creation sites for heap audit"
    depends on MATTER_C_RUNTIME_HEAP_AUDIT
    default n
    help
        Diagnostic link wrappers keep at most 128 live queue identities and
        creation PCs in static RAM. No allocation or log inside wrappers.
        Changes memory layout; use for attribution, not headline RAM numbers.
config MATTER_C_RUNTIME_CHIP_RESUMPTION
    bool "Explicit CHIP-compatible CASE resumption traffic KDF for lab peers"
    default y
    help
        Mirrors the existing host lab. ConnectedHomeIP and Matter.js0.17.9 use
        the previous resumption ID for SessionResumptionKeys. Disabling selects
        the core's SPEC profile (new Sigma2Resume ID). No ciphertext detection
        or fallback between profiles; both peers must agree.
config MATTER_C_RUNTIME_OOM_SWEEP
    bool "Fault every tracked runtime-constructor allocation once per lab state"
    default y
    help
        Deliberately slow test, completed before serving. Tracks library/adapter
        allocations only, not all internal SDK/PSA failures.
endmenu
