# DevKitM-1 UART0 on the same pins as the default console.
# A custom console is required for ESP-IDF to retain a non-default baud rate.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=16
CONFIG_ESP_CONSOLE_UART_RX_GPIO=17
CONFIG_ESP_CONSOLE_UART_BAUDRATE=1000000
